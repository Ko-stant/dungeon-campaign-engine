# Copy to .env and change the password. The Makefile, docker-compose and the Go commands read it.
POSTGRES_USER=hq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hq
POSTGRES_PORT=5433
DATABASE_URL=postgres://hq:change-me@localhost:5433/hq?sslmode=disable

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://hq:change-me@localhost:5433/hq?sslmode=disable
GOOSE_MIGRATION_DIR=./db/migrations

# Optional
# APP_PORT=8080
# AUDIO_DIR=./audio
