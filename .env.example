# Copy to .env and change the password. The Makefile, docker-compose and the Go commands read it.
# Beside a main checkout, use another port and database name (e.g. 5435, hq_online).
POSTGRES_USER=hq
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hq
POSTGRES_PORT=5433
DATABASE_URL=postgres://hq:change-me@localhost:5433/hq?sslmode=disable

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://hq:change-me@localhost:5433/hq?sslmode=disable
GOOSE_MIGRATION_DIR=./db/migrations

# Optional
# APP_PORT=8080

# Sign-in (unset: off, the table companion). none, discord or dev (dev: loopback only).
# AUTH_MODE=dev
# AUTH_ADMINS=dev:gm
# AUTH_MEMBERS=approve
# PUBLIC_URL=http://localhost:8080
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Hosting (make image / push / deploy / hosted-backup). The hook and URL are secrets.
# DOCKER_IMAGE=youruser/dungeon-campaign-engine
# RENDER_DEPLOY_HOOK=
# HOSTED_DATABASE_URL=
