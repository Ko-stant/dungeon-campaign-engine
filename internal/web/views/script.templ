package views

import "fmt"

// AudioClipRow is one read-aloud audio clip on the campaign page.
type AudioClipRow struct {
	ID      string
	File    string
	URL     string
	Passage string // "Q2-03 The tithe barn"; empty when no passage has this id
}

func scriptSize(d CampaignPageData) string {
	plural := func(n int, word string) string {
		if n == 1 {
			return "1 " + word
		}
		return fmt.Sprintf("%d %ss", n, word)
	}
	return plural(d.ScriptPassages, "passage") + " in " + plural(d.ScriptSections, "section")
}

// campaignScript is the campaign's read-aloud script: the GM pastes it here
// and the tracker's Read aloud panel shows it during play.
templ campaignScript(d CampaignPageData) {
	<section id="script" class={ cardClass + " space-y-3" }>
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			<h2 class="text-lg font-semibold">Read-aloud script</h2>
			if d.ScriptPassages > 0 {
				<span class="text-sm opacity-70">{ scriptSize(d) }</span>
			} else {
				<span class="text-sm opacity-70">No script yet</span>
			}
		</div>
		<p class="text-xs opacity-60">
			Paste the campaign's script (the format of <code>docs/campaigns/three-plagues/script/</code>, or load a script folder with <code>make load-script</code>): <code>## Section</code> headings,
			<code>### ID - Title</code> passages, <code>- **When:** ...</code> notes, <code>**Speaker**</code> lines and <code>&gt;</code> quoted text.
			The tracker's Read aloud panel shows it during play; a running quest picks up edits with the panel's Reload button.
		</p>
		if d.ScriptError != "" {
			<p class="rounded-md border border-danger/60 bg-danger/10 px-3 py-2 text-sm text-danger" role="alert">{ d.ScriptError }</p>
		}
		<form method="post" action={ templ.SafeURL("/campaigns/" + d.ID + "/script") } class="space-y-2">
			<textarea name="script" rows="14" spellcheck="true" aria-label="Read-aloud script" class={ inputClass + " font-mono text-xs" }>{ d.ScriptText }</textarea>
			<button type="submit" class={ buttonClass }>Save script</button>
		</form>
	</section>
	@campaignAudio(d)
}

// campaignAudio lists the script's audio clips and uploads more.
templ campaignAudio(d CampaignPageData) {
	<section id="audio" class={ cardClass + " space-y-3" }>
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			<h2 class="text-lg font-semibold">Audio clips</h2>
			<span class="text-sm opacity-70">{ fmt.Sprintf("%d clips", len(d.AudioClips)) }</span>
		</div>
		<p class="text-xs opacity-60">
			Name each file after its passage id (<code>Q2-03.mp3</code>); <code>Q3-09a.mp3</code> is extra clip "a" of passage Q3-09.
			Formats: mp3, m4a, ogg, opus, wav, webm, flac; up to 50 MB each. Uploading an id again replaces its clip.
			The tracker's reader plays them.
		</p>
		if d.AudioError != "" {
			<p class="rounded-md border border-danger/60 bg-danger/10 px-3 py-2 text-sm text-danger" role="alert">{ d.AudioError }</p>
		}
		<form method="post" action={ templ.SafeURL("/campaigns/" + d.ID + "/audio") } enctype="multipart/form-data" class="flex flex-wrap items-center gap-3">
			<input type="file" name="clips" multiple required accept=".mp3,.m4a,.ogg,.opus,.wav,.webm,.flac,audio/*" aria-label="Audio clips" class="text-sm"/>
			<button type="submit" class={ buttonClass }>Upload</button>
		</form>
		if len(d.AudioClips) > 0 {
			<ul class="divide-y divide-border/40 rounded-md border border-border/40">
				for _, c := range d.AudioClips {
					<li class="flex flex-wrap items-center gap-3 px-3 py-2 text-sm">
						<span class="w-40 font-mono text-xs">{ c.File }</span>
						if c.Passage != "" {
							<span class="min-w-40 flex-1">{ c.Passage }</span>
						} else {
							<span class="min-w-40 flex-1 text-warning">no passage with this id</span>
						}
						<audio controls preload="none" src={ c.URL } class="h-8"></audio>
						<form method="post" action={ templ.SafeURL("/campaigns/" + d.ID + "/audio/" + c.ID + "/delete") }>
							<button type="submit" class="text-xs text-danger hover:underline" aria-label={ "Delete clip " + c.File } data-confirm={ "Delete the audio clip " + c.File + "? The clip is deleted for good." }>Delete</button>
						</form>
					</li>
				}
			</ul>
		}
	</section>
}
