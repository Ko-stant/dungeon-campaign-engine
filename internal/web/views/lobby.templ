package views

import (
	"github.com/Ko-stant/dungeon-campaign-engine/internal/web/views/components"
	"time"
)

// LobbyItem is one open game in the lobby.
type LobbyItem struct {
	SessionID    string
	Name         string
	CampaignName string
	GMName       string
	Started      bool
	UpdatedAt    time.Time
}

// LobbyPage lists the games open to players.
templ LobbyPage(games []LobbyItem) {
	@components.Page("Play", "") {
		<main class="mx-auto max-w-4xl space-y-8 p-6">
			<header class="flex items-baseline justify-between">
				<div>
					<h1 class="text-2xl font-bold text-amber-400">Play</h1>
					<span class="text-sm opacity-70">Games your GM has opened to players</span>
				</div>
				@appNav("lobby")
			</header>
			if len(games) == 0 {
				<p class="text-sm opacity-70">No open games right now. Your GM opens a session for players from their campaign page.</p>
			}
			<ul class="divide-y divide-border/40 rounded-lg border border-border/60">
				for _, g := range games {
					<li class="flex items-center justify-between px-4 py-3 text-sm">
						<div>
							<span class="font-semibold">{ g.Name }</span>
							<span class="ml-2 text-xs opacity-60">
								{ g.CampaignName }
								if g.GMName != "" {
									· GM { g.GMName }
								}
								if g.Started {
									· in play
								} else {
									· waiting to start
								}
							</span>
						</div>
						<a href={ templ.SafeURL("/join/" + g.SessionID) } class={ linkButton }>Join</a>
					</li>
				}
			</ul>
		</main>
	}
}

// JoinHero is a campaign hero on the join page.
type JoinHero struct {
	ID        string
	Name      string
	ClassName string
	Player    string
}

// ClassChoice is a class a new hero may take.
type ClassChoice struct {
	ID   string
	Name string
}

// JoinData is the join page: the player's heroes, the free ones, and the
// classes for a new hero.
type JoinData struct {
	SessionID    string
	SessionName  string
	CampaignName string
	Yours        []JoinHero
	Free         []JoinHero
	Taken        []JoinHero
	Classes      []ClassChoice
	Error        string
}

// JoinPage lets a player pick a free hero or make a new one for a game.
templ JoinPage(d JoinData) {
	@components.Page("Join "+d.SessionName, "") {
		<main class="mx-auto max-w-3xl space-y-6 p-6">
			<header class="flex items-baseline justify-between">
				<div>
					<h1 class="text-2xl font-bold text-amber-400">{ d.SessionName }</h1>
					<span class="text-sm opacity-70">{ d.CampaignName }</span>
				</div>
				@appNav("lobby")
			</header>
			if d.Error != "" {
				<p class="rounded-md border border-danger/60 bg-danger/10 px-3 py-2 text-sm text-danger" role="alert">{ d.Error }</p>
			}
			<section class={ cardClass }>
				<h2 class="mb-3 text-lg font-semibold">Your heroes</h2>
				if len(d.Yours) == 0 {
					<p class="text-sm opacity-70">None yet: pick a free hero or make one below.</p>
				} else {
					<ul class="space-y-1 text-sm">
						for _, h := range d.Yours {
							<li><span class="font-semibold">{ h.Name }</span> <span class="opacity-60">{ h.ClassName }</span></li>
						}
					</ul>
					<a href={ templ.SafeURL("/play/" + d.SessionID + "/seat") } class={ "mt-3 inline-block " + buttonClass }>Play</a>
				}
			</section>
			if len(d.Free) > 0 {
				<section class={ cardClass }>
					<h2 class="mb-3 text-lg font-semibold">Free heroes</h2>
					<ul class="space-y-2 text-sm">
						for _, h := range d.Free {
							<li class="flex items-center justify-between">
								<span><span class="font-semibold">{ h.Name }</span> <span class="opacity-60">{ h.ClassName }</span></span>
								<form method="post" action={ templ.SafeURL("/join/" + d.SessionID + "/claim/" + h.ID) }>
									<button type="submit" class={ linkButton }>Play this hero</button>
								</form>
							</li>
						}
					</ul>
				</section>
			}
			<section class={ cardClass }>
				<h2 class="mb-3 text-lg font-semibold">Make a new hero</h2>
				<form method="post" action={ templ.SafeURL("/join/" + d.SessionID + "/hero") } class="grid gap-3 sm:grid-cols-[1fr_12rem_auto] sm:items-end">
					<label class="block text-sm">
						<span class="mb-1 block opacity-80">Name</span>
						<input name="name" required maxlength="120" class={ inputClass }/>
					</label>
					<label class="block text-sm">
						<span class="mb-1 block opacity-80">Class</span>
						<select name="class" required class={ inputClass }>
							for _, c := range d.Classes {
								<option value={ c.ID }>{ c.Name }</option>
							}
						</select>
					</label>
					<button type="submit" class={ buttonClass }>Make and join</button>
				</form>
			</section>
			if len(d.Taken) > 0 {
				<section class="text-sm opacity-70">
					<h2 class="mb-1 font-semibold">Also playing</h2>
					<ul>
						for _, h := range d.Taken {
							<li>{ h.Name } ({ h.ClassName }) · { h.Player }</li>
						}
					</ul>
				</section>
			}
		</main>
	}
}

// SeatPage is the shell for a player's game screen (pages/seat.ts).
templ SeatPage(sessionID string, title string) {
	@components.Page(title, "seat") {
		<div id="seat" data-session-id={ sessionID } class="flex min-h-screen flex-col lg:h-screen lg:overflow-hidden">
			<noscript class="p-6">The game needs JavaScript.</noscript>
		</div>
	}
}
